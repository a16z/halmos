/-
  Clause templates of the CNF encoder (src/dolmos/keccak_sat.py).

  GENERATED by `python -m dolmos.keccak_sat lean-templates`, do not edit:
  tests/test_keccak_sat.py checks that this file is in sync with the encoder.

  A clause over lanes is bit-sliced: `l1 ||| l2 ||| l3 = -1` states that the clause
  `l1[i] ∨ l2[i] ∨ l3[i]` holds at each bit position i (see `clause_iff_bits`).
-/
import Std.Tactic.BVDecide

namespace KeccakSat

/-- a bit-sliced clause holds iff it holds at each of the 64 bit positions -/
theorem clause_iff_bits (c : BitVec 64) : c = -1#64 ↔ ∀ i : Fin 64, c[i] = true := by
  have ones : ∀ i : Fin 64, (-1#64)[i] = true := by decide
  constructor
  · intro h i; subst h; exact ones i
  · intro h; apply BitVec.eq_of_getElem_eq; intro i hi
    exact (h ⟨i, hi⟩).trans (ones ⟨i, hi⟩).symm

/-- the 4 clauses of the gate `o = a ^^^ b` -/
def xor2Cnf (a b o : BitVec 64) : Prop :=
  (a ||| b ||| ~~~o = -1#64) ∧
  (~~~a ||| ~~~b ||| ~~~o = -1#64) ∧
  (~~~a ||| b ||| o = -1#64) ∧
  (a ||| ~~~b ||| o = -1#64)

theorem xor2Cnf_iff (a b o : BitVec 64) : xor2Cnf a b o ↔ o = a ^^^ b := by
  unfold xor2Cnf; bv_decide

/-- the 8 clauses of the gate `o = a ^^^ b ^^^ c` -/
def xor3Cnf (a b c o : BitVec 64) : Prop :=
  (a ||| b ||| c ||| ~~~o = -1#64) ∧
  (~~~a ||| ~~~b ||| c ||| ~~~o = -1#64) ∧
  (~~~a ||| b ||| ~~~c ||| ~~~o = -1#64) ∧
  (a ||| ~~~b ||| ~~~c ||| ~~~o = -1#64) ∧
  (~~~a ||| b ||| c ||| o = -1#64) ∧
  (a ||| ~~~b ||| c ||| o = -1#64) ∧
  (a ||| b ||| ~~~c ||| o = -1#64) ∧
  (~~~a ||| ~~~b ||| ~~~c ||| o = -1#64)

theorem xor3Cnf_iff (a b c o : BitVec 64) : xor3Cnf a b c o ↔ o = a ^^^ b ^^^ c := by
  unfold xor3Cnf; bv_decide

/-- the 3 clauses of the gate `o = a &&& b` -/
def andCnf (a b o : BitVec 64) : Prop :=
  (a ||| ~~~o = -1#64) ∧
  (b ||| ~~~o = -1#64) ∧
  (~~~a ||| ~~~b ||| o = -1#64)

theorem andCnf_iff (a b o : BitVec 64) : andCnf a b o ↔ o = a &&& b := by
  unfold andCnf; bv_decide

/-- the 6 clauses of the gate `o = a ^^^ (~~~b &&& c)` -/
def chiCnf (a b c o : BitVec 64) : Prop :=
  (a ||| c ||| ~~~o = -1#64) ∧
  (~~~a ||| c ||| o = -1#64) ∧
  (a ||| ~~~b ||| ~~~o = -1#64) ∧
  (~~~a ||| ~~~b ||| o = -1#64) ∧
  (a ||| b ||| ~~~c ||| o = -1#64) ∧
  (~~~a ||| b ||| ~~~c ||| ~~~o = -1#64)

theorem chiCnf_iff (a b c o : BitVec 64) : chiCnf a b c o ↔ o = a ^^^ (~~~b &&& c) := by
  unfold chiCnf; bv_decide

end KeccakSat
